<!-- osgEarth map for s376-visual.
     Used only when the binary is built with osgEarth. Swap the image/elevation
     layers for local MBTiles / GeoTIFF when you go offline. Attribution:
     Esri World Imagery (development). See docs/SOURCES.md. -->
<map name="s376" type="geocentric" version="2">
    <options>
        <terrain>
            <min_tile_range_ratio>4</min_tile_range_ratio>
        </terrain>
    </options>
    <image name="esri-world-imagery" driver="xyz">
        <url>https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}</url>
        <profile>spherical-mercator</profile>
    </image>
    <!-- Uncomment when you have a local DEM:
    <elevation name="local-dem" driver="gdal">
        <url>data/dem/copernicus.tif</url>
    </elevation>
    -->
</map>
